.{
    .name = .http_framework,
    .version = "1.0.0",
    .description = "A high-performance HTTP framework for Zig with std.Io/zio support",
    .license = "MIT",
    .keywords = .{ "zig", "http", "framework", "websocket", "orm" },
    .fingerprint = 0xfe7cb1c07e898ad5,
    .dependencies = .{
        // zio 上游 main（0.20.1/b0efa2b，2026-11-15）落后于本机 std 一步：
        // dev.1124 把 `packed struct/union` 更名为 `bitpack`、`<< |`/`% *` 组合
        // 要求显式括号；dev.1240 又改了 std.Io 内部布局（Operation.Result 变大、
        // Io.File.Uid 在 Windows 上变 void、std.builtin.os 移除等）。上游未跟进，
        // 因此 vendor 一份并打最小补丁（清单见 vendor/zio/README.md）。
        // 上游跟进后可换回 url/hash 依赖。

        .zio = .{
            .path = "vendor/zio",
        },
    },
    .minimum_zig_version = "0.18.0-dev",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        // M-14：url/hash 消费者构建必需——build.zig 的 zio 依赖指向 vendor/zio，
        // gen-api 工具在 tools/；缺目录时依赖方编译直接失败（本地路径依赖
        // 不走 .paths 过滤，所以日常开发发现不了）。
        "tools",
        "vendor",
        "README.md",
    },
}

.{
    .name = .http_framework,
    .version = "1.0.0",
    .description = "A high-performance HTTP framework for Zig with std.Io/zio support",
    .license = "MIT",
    .keywords = .{ "zig", "http", "framework", "websocket", "orm" },
    .fingerprint = 0xfe7cb1c07e898ad5,
    .dependencies = .{
        // zio 上游 main（0.19.0）落后于本机 std 一步：std 把 netAccept 等 VTable 字段
        // 改成了 snake_case，上游未跟进，因此 vendor 一份并打最小补丁（见 vendor/zio/README.md）。
        // 上游跟进后可换回 url/hash 依赖。
        .zio = .{
            .path = "vendor/zio",
        },
    },
    .minimum_zig_version = "0.18.0-dev",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
    },
}
